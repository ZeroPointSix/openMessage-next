{
  "name": "@openmessage/user-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "dev": "vite --host 0.0.0.0",
    "start": "node --env-file-if-exists=.env src/server/index.ts",
    "test": "vitest run"
  },
  "engines": {"node": ">=24.0.0", "pnpm": ">=11.0.0"},
  "dependencies": {
    "@fastify/static": "8.3.0",
    "fastify": "5.12.3",
    "@lucide/svelte": "1.46.0",
    "svelte": "5.39.6"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.1.4",
    "@tailwindcss/vite": "4.1.13",
    "@types/node": "26.5.1",
    "svelte-check": "4.3.2",
    "tailwindcss": "4.1.13",
    "typescript": "6.0.3",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
